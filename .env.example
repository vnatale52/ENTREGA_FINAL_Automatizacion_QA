# ==============================================================================
# Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como '.env' si deseas sobreescribir la configuración local
# ==============================================================================

# URLs base de los sistemas bajo prueba (UI y API REST)
BASE_URL_UI=https://www.saucedemo.com
BASE_URL_API=https://jsonplaceholder.typicode.com

# Tiempos de espera explícitos (segundos) y umbral máximo de respuesta API (segundos)
DEFAULT_TIMEOUT=10
API_MAX_RESPONSE_TIME=3.0

# Pausa visual por pantalla en modo ventana visible (segundos) y navegador por defecto
VISUAL_DELAY_SECONDS=5
BROWSER=chrome

